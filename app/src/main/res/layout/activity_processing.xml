<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/stemwerk_bg_top"
    android:padding="16dp">

    <TextView
        android:id="@+id/procTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Processing…"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="@color/stemwerk_text_primary" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:progressTint="@color/stemwerk_accent"
        android:max="100" />

    <TextView
        android:id="@+id/progressText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Starting…"
        android:textColor="@color/stemwerk_text_secondary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:background="@color/stemwerk_card"
        android:padding="10dp">

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:typeface="monospace"
            android:textColor="@color/stemwerk_text_muted"
            android:text="" />

    </ScrollView>

    <Button
        android:id="@+id/previewOutputButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/stemwerk_button"
        android:textColor="@color/stemwerk_button_text"
        android:text="Listen / waveforms"
        android:enabled="false" />

    <Button
        android:id="@+id/shareButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/stemwerk_button"
        android:textColor="@color/stemwerk_button_text"
        android:text="Share output (.zip)"
        android:enabled="false" />

    <Button
        android:id="@+id/closeButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/stemwerk_button_primary"
        android:textColor="@color/stemwerk_button_text"
        android:text="Close"
        android:enabled="false" />

</LinearLayout>
