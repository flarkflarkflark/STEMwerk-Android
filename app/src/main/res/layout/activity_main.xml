<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/stemwerk_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:background="@color/stemwerk_bg_top"
            android:padding="8dp">

            <WebView
                android:id="@+id/logoWebView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:id="@+id/logoFallback"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/stemwerk_icon_foreground"
                android:scaleType="centerInside"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: idle — real 2-stem MDX ready"
            android:textColor="@color/stemwerk_text_secondary"
            android:textSize="14sp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/pickAudioButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/stemwerk_button"
            android:textColor="@color/stemwerk_button_text"
            android:text="Pick audio" />

        <TextView
            android:id="@+id/audioSelectedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No audio selected"
            android:textColor="@color/stemwerk_text_muted"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/pickModelButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/stemwerk_button"
            android:textColor="@color/stemwerk_button_text"
            android:text="Pick model" />

        <TextView
            android:id="@+id/modelSelectedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No model selected"
            android:textColor="@color/stemwerk_text_muted"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/pickBackendButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/stemwerk_button"
            android:textColor="@color/stemwerk_button_text"
            android:text="Choose inference route" />

        <TextView
            android:id="@+id/backendSelectedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Auto — NNAPI hardware, then CPU"
            android:textColor="@color/stemwerk_text_muted"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Output folder"
            android:textColor="@color/stemwerk_text_secondary"
            android:textStyle="bold" />

        <Button
            android:id="@+id/pickOutputFolderButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/stemwerk_button"
            android:textColor="@color/stemwerk_button_text"
            android:text="Choose output folder" />

        <TextView
            android:id="@+id/outputFolderText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Not set (will use app folder)"
            android:textColor="@color/stemwerk_text_muted"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stems"
            android:textColor="@color/stemwerk_text_secondary"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/stemwerk_card"
            android:orientation="vertical"
            android:padding="10dp"
            android:paddingBottom="12dp">

            <CheckBox
                android:id="@+id/stemVocals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/stemwerk_vocals"
                android:checked="true"
                android:text="Vocals"
                android:textColor="@color/stemwerk_vocals" />

            <CheckBox
                android:id="@+id/stemOther"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/stemwerk_other"
                android:checked="true"
                android:text="Other / instrumental"
                android:textColor="@color/stemwerk_other" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:text="Drums en bass volgen in een latere model-slice."
                android:textColor="@color/stemwerk_text_muted" />
        </LinearLayout>

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/stemwerk_button_primary"
            android:textColor="@color/stemwerk_button_text"
            android:text="Split" />

        <TextView
            android:id="@+id/helpText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="Offline extractie via een echt ONNX MDX-model. Auto probeert Android NNAPI-hardware en valt terug op ARM64 CPU."
            android:textColor="@color/stemwerk_text_muted" />

    </LinearLayout>
</ScrollView>
