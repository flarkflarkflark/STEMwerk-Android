<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/stemwerk_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:background="@color/stemwerk_bg_top"
            android:padding="8dp">

            <WebView
                android:id="@+id/logoWebView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:id="@+id/logoFallback"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: idle — mobile backend pending"
            android:textColor="@color/stemwerk_text_secondary"
            android:textSize="14sp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/pickAudioButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/stemwerk_button"
            android:textColor="@color/stemwerk_button_text"
            android:text="Pick audio" />

        <TextView
            android:id="@+id/audioSelectedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No audio selected"
            android:textColor="@color/stemwerk_text_muted"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/pickModelButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/stemwerk_button"
            android:textColor="@color/stemwerk_button_text"
            android:text="Pick model" />

        <TextView
            android:id="@+id/modelSelectedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No model selected"
            android:textColor="@color/stemwerk_text_muted"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Output folder"
            android:textColor="@color/stemwerk_text_secondary"
            android:textStyle="bold" />

        <Button
            android:id="@+id/pickOutputFolderButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/stemwerk_button"
            android:textColor="@color/stemwerk_button_text"
            android:text="Choose output folder" />

        <TextView
            android:id="@+id/outputFolderText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Not set (will use app folder)"
            android:textColor="@color/stemwerk_text_muted"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stems"
            android:textColor="@color/stemwerk_text_secondary"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/stemwerk_card"
            android:orientation="vertical"
            android:padding="10dp"
            android:paddingBottom="12dp">

            <CheckBox
                android:id="@+id/stemVocals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/stemwerk_vocals"
                android:checked="true"
                android:text="Vocals"
                android:textColor="@color/stemwerk_vocals" />

            <CheckBox
                android:id="@+id/stemDrums"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/stemwerk_drums"
                android:checked="true"
                android:text="Drums"
                android:textColor="@color/stemwerk_drums" />

            <CheckBox
                android:id="@+id/stemBass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/stemwerk_bass"
                android:checked="true"
                android:text="Bass"
                android:textColor="@color/stemwerk_bass" />

            <CheckBox
                android:id="@+id/stemOther"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/stemwerk_other"
                android:checked="true"
                android:text="Other"
                android:textColor="@color/stemwerk_other" />
        </LinearLayout>

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/stemwerk_button_primary"
            android:textColor="@color/stemwerk_button_text"
            android:text="Split" />

        <TextView
            android:id="@+id/helpText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="Foundation build: model download and UI plumbing are present, but no fake stems are written. Real 2-/4-stem mobile inference follows the model export/parity test."
            android:textColor="@color/stemwerk_text_muted" />

    </LinearLayout>
</ScrollView>
